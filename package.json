{
  "name": "sketchicon-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run generate && npm run build -w @sketchicon/core && npm run build -w @sketchicon/react && npm run build -w sketchicon && npm run build -w @sketchicon/web",
    "check": "npm run build && npm run typecheck && npm test && npm run verify:catalog && npm run verify:package && npm run verify:bundle && npm run verify:web",
    "dev": "npm run dev -w @sketchicon/web",
    "generate": "node scripts/generate-lucide.mjs",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:web": "node scripts/verify-web.mjs"
  },
  "dependencies": {
    "lucide-static": "^1.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
