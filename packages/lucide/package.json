{
  "name": "sketchicon",
  "version": "0.1.0",
  "description": "Hand-drawn sketch icons for React",
  "keywords": ["icons", "react", "sketch", "hand-drawn", "svg"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "compatibility-report.json", "THIRD_PARTY_NOTICES.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsup src/runtime.ts src/core.ts --format esm --dts --splitting --out-dir dist --external react --external react/jsx-runtime",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
