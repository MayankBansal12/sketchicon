{
  "name": "@sketchicon/lucide",
  "version": "0.2.0-beta.2",
  "description": "Lucide geometry for SketchIcon",
  "keywords": ["icons", "lucide", "sketch", "hand-drawn", "svg"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "compatibility-report.json", "THIRD_PARTY_NOTICES.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/ensure-generated.mjs",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/write-provider-declarations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sketchicon/core": "0.2.0-beta.2"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayankBansal12/sketchicon.git",
    "directory": "packages/lucide"
  },
  "homepage": "https://github.com/MayankBansal12/sketchicon#readme",
  "bugs": {
    "url": "https://github.com/MayankBansal12/sketchicon/issues"
  },
  "license": "MIT"
}
