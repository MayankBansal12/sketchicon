{
  "name": "@sketchicon/preact",
  "version": "0.2.0",
  "description": "Deterministic hand-drawn SVG icons for Preact",
  "keywords": [
    "icons",
    "preact",
    "sketch",
    "svg"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsup src/index.ts --format esm --dts --external preact --external @sketchicon/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sketchicon/core": "0.2.0"
  },
  "peerDependencies": {
    "preact": "^10.29.8"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayankBansal12/sketchicon.git",
    "directory": "packages/preact"
  },
  "license": "MIT"
}
