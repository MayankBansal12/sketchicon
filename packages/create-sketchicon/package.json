{
  "name": "create-sketchicon",
  "version": "0.2.0-beta.1",
  "description": "Interactive installer and migration tool for SketchIcon",
  "keywords": ["icons", "react", "initializer", "cli", "sketchicon"],
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "create-sketchicon": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
