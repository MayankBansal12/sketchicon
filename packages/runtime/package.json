{
  "name": "sketchicon",
  "version": "0.2.0",
  "description": "Deterministic hand-drawn SVG icons for React and React Native",
  "keywords": ["icons", "react", "react-native", "expo", "sketch", "hand-drawn", "svg"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "MIGRATION.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sketchicon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsup src/index.ts src/runtime.ts src/server.ts src/core.ts src/native.ts src/cli.ts --format esm --dts --splitting --out-dir dist --external react --external react/jsx-runtime --external @sketchicon/core --external react-native-svg",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sketchicon/core": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-native": ">=0.79 <1",
    "react-native-svg": ">=15 <16"
  },
  "peerDependenciesMeta": {
    "react-native": { "optional": true },
    "react-native-svg": { "optional": true }
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayankBansal12/sketchicon.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/MayankBansal12/sketchicon#readme",
  "bugs": {
    "url": "https://github.com/MayankBansal12/sketchicon/issues"
  },
  "license": "MIT"
}
